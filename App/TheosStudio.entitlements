<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TheosStudio.entitlements — what a build tool needs that an App Store app can
  never have.

  These are platform entitlements: Apple's signing infrastructure will not grant
  them, which is why the app ships unsigned in a .deb and is signed on device by
  `ldid -STheosStudio.entitlements` (Packaging/build-deb.sh). A normal Xcode build
  ignores this file entirely (CODE_SIGNING_ALLOWED=NO in App/project.yml).

  Every key here is load-bearing:

  - platform-application
    Marks the binary as a platform binary. Without it, amfid refuses to run a
    binary carrying the sandbox-bypass keys below and the app dies at launch with
    a code-signing error.
  - com.apple.private.security.no-container / container-required = false
    Run outside the app data container. Theos is not inside the container: it
    lives in /var/jb or /opt, and so do the SDK, the toolchain and the projects.
  - run-unsigned-code
    A build runs make, clang, ldid and dpkg-deb, none of which are signed by
    Apple. On jailbreaks that check, exec'ing them is refused without this.
  - task_for_pid-allow
    Looking at the processes a build spawns is the difference between a failed
    build you can diagnose and one that only says "Error 1".
  - com.apple.private.security.storage.var
    Needed on rootless jailbreaks, where dpkg's database and the build's own
    temporary files are under /var/jb and /var, outside the container.
  - get-task-allow
    So a debugger can attach to a Debug build on device.
-->
<plist version="1.0">
<dict>
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
	<key>com.apple.private.security.storage.var</key>
	<true/>
	<key>run-unsigned-code</key>
	<true/>
	<key>task_for_pid-allow</key>
	<true/>
	<key>get-task-allow</key>
	<true/>

	<!--
	  application-identifier / keychain-access-groups
	  Without these, securityd refuses every keychain operation from an ad-hoc
	  signed app and SecItemAdd fails with errSecMissingEntitlement (-34018) — which
	  is exactly what "the API key is not saving" looks like. The group is the app's
	  own bundle identifier, so nothing else can read the key.
	-->
	<key>application-identifier</key>
	<string>com.r0gueee.theosstudio</string>
	<key>keychain-access-groups</key>
	<array>
		<string>com.r0gueee.theosstudio</string>
	</array>
	<key>com.apple.developer.team-identifier</key>
	<string>R0GUEEE</string>
</dict>
</plist>
